<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- NEXUS privacy hardening: reject unencrypted HTTP traffic by default. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
